{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraswe.dev/schemas/blackwell-feature-pack.schema.json",
  "title": "InfraSWE B200 compiler-feature pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "status",
    "hardware_profile",
    "stable_baseline",
    "target_lanes",
    "packs",
    "mvp_feature_ids",
    "evidence_contract",
    "scoring_contract"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "suite_id": { "const": "b200-sm100-compiler-features-v0.1" },
    "status": { "const": "initial_adapter" },
    "hardware_profile": { "const": "gpu-1x-sm100-b200-cuda133" },
    "stable_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuda_series", "ptx_isa"],
      "properties": {
        "cuda_series": { "const": "13.3" },
        "ptx_isa": { "const": "9.3" }
      }
    },
    "target_lanes": {
      "const": ["sm_100", "sm_100f", "sm_100a"]
    },
    "packs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["pack_id", "namespace", "runtime_scope", "feature_ids"],
        "properties": {
          "pack_id": { "type": "string" },
          "namespace": { "enum": ["SM100-Core", "SM100-Scheduler", "SM100-Fabric", "PTX-Preview"] },
          "runtime_scope": { "enum": ["single_gpu", "multi_gpu", "compile_only"] },
          "feature_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "optional": { "type": "boolean" },
          "disabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "mvp_feature_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "evidence_contract": { "type": "object" },
    "scoring_contract": {
      "type": "object",
      "required": ["certification_coverage_is_performance_score", "leaderboard_score_100", "performance_pack_status"],
      "properties": {
        "certification_coverage_is_performance_score": { "const": false },
        "leaderboard_score_100": { "type": "null" },
        "performance_pack_status": { "const": "not_implemented" }
      },
      "additionalProperties": false
    }
  }
}
