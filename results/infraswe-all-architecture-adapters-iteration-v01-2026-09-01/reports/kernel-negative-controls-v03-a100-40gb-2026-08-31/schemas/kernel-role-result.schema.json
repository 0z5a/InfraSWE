{
  "$defs": {
    "Authority": {
      "enum": [
        "gate",
        "metric",
        "score",
        "audit",
        "advisory"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Disposition": {
      "enum": [
        "valid",
        "invalid",
        "quarantined",
        "not_applicable"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FailureCode": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*(?::.*)?$",
          "title": "Code",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "owner",
        "retryable"
      ],
      "title": "FailureCode",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "statistic": {
          "minLength": 1,
          "title": "Statistic",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "statistic",
        "population"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "RoleIdentity": {
      "additionalProperties": false,
      "properties": {
        "build_artifact_sha256": {
          "title": "Build Artifact Sha256",
          "type": "string"
        },
        "candidate_source_sha256": {
          "title": "Candidate Source Sha256",
          "type": "string"
        },
        "environment_contract_sha256": {
          "title": "Environment Contract Sha256",
          "type": "string"
        },
        "evaluator_sha256": {
          "title": "Evaluator Sha256",
          "type": "string"
        },
        "execution_environment_sha256": {
          "title": "Execution Environment Sha256",
          "type": "string"
        },
        "hardware_class_sha256": {
          "title": "Hardware Class Sha256",
          "type": "string"
        },
        "role_graph_sha256": {
          "title": "Role Graph Sha256",
          "type": "string"
        },
        "task_package_sha256": {
          "title": "Task Package Sha256",
          "type": "string"
        }
      },
      "required": [
        "task_package_sha256",
        "candidate_source_sha256",
        "build_artifact_sha256",
        "role_graph_sha256",
        "evaluator_sha256",
        "hardware_class_sha256",
        "environment_contract_sha256",
        "execution_environment_sha256"
      ],
      "title": "RoleIdentity",
      "type": "object"
    },
    "RoleInput": {
      "additionalProperties": false,
      "properties": {
        "result_sha256": {
          "title": "Result Sha256",
          "type": "string"
        },
        "role_instance_id": {
          "title": "Role Instance Id",
          "type": "string"
        }
      },
      "required": [
        "role_instance_id",
        "result_sha256"
      ],
      "title": "RoleInput",
      "type": "object"
    },
    "RoleStatus": {
      "enum": [
        "completed",
        "error",
        "timeout",
        "cancelled",
        "skipped"
      ],
      "title": "RoleStatus",
      "type": "string"
    },
    "Scope": {
      "enum": [
        "trial",
        "replay",
        "case",
        "replay-case",
        "search"
      ],
      "title": "Scope",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Assertions",
      "type": "object"
    },
    "attempt_index": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt Index",
      "type": "integer"
    },
    "authority": {
      "$ref": "#/$defs/Authority"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "failure_codes": {
      "items": {
        "$ref": "#/$defs/FailureCode"
      },
      "title": "Failure Codes",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/RoleIdentity"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/RoleInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Metrics",
      "type": "object"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "replay_index": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Index"
    },
    "result_sha256": {
      "default": "",
      "title": "Result Sha256",
      "type": "string"
    },
    "role_id": {
      "title": "Role Id",
      "type": "string"
    },
    "role_instance_id": {
      "title": "Role Instance Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.3",
      "pattern": "^0\\.3$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "signature": {
      "default": "",
      "title": "Signature",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RoleStatus"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "role_id",
    "role_instance_id",
    "authority",
    "scope",
    "status",
    "verdict",
    "disposition",
    "profile",
    "identity",
    "started_at",
    "finished_at"
  ],
  "title": "RoleResult",
  "type": "object"
}
