{
  "$defs": {
    "ArtifactConfig": {
      "additionalProperties": false,
      "properties": {
        "config_paths": {
          "items": {
            "type": "string"
          },
          "title": "Config Paths",
          "type": "array"
        },
        "require_clean_patch": {
          "default": true,
          "title": "Require Clean Patch",
          "type": "boolean"
        }
      },
      "title": "ArtifactConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_timeout_sec": {
          "default": 900,
          "exclusiveMinimum": 0,
          "title": "Agent Timeout Sec",
          "type": "integer"
        },
        "gpu_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Minutes",
          "type": "number"
        },
        "max_infra_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Infra Cost Usd",
          "type": "number"
        },
        "max_model_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Model Cost Usd",
          "type": "number"
        },
        "verifier_timeout_sec": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Verifier Timeout Sec",
          "type": "integer"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_image": {
          "default": "python:3.12-slim",
          "title": "Agent Image",
          "type": "string"
        },
        "agent_mode": {
          "default": "docker",
          "enum": [
            "local",
            "docker",
            "vm",
            "kubernetes"
          ],
          "title": "Agent Mode",
          "type": "string"
        },
        "exclusive_gpu_lease": {
          "default": false,
          "title": "Exclusive Gpu Lease",
          "type": "boolean"
        },
        "gpu_count": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Gpu Count",
          "type": "integer"
        },
        "mps": {
          "default": "not-applicable",
          "enum": [
            "disabled",
            "enabled",
            "not-applicable"
          ],
          "title": "Mps",
          "type": "string"
        },
        "network": {
          "default": "deny",
          "enum": [
            "deny",
            "allowlist"
          ],
          "title": "Network",
          "type": "string"
        },
        "profile": {
          "default": "cpu-small",
          "title": "Profile",
          "type": "string"
        },
        "shm_size": {
          "default": "256m",
          "pattern": "^[1-9][0-9]*(?:[kKmMgG])$",
          "title": "Shm Size",
          "type": "string"
        },
        "verifier_image": {
          "default": "python:3.12-slim",
          "title": "Verifier Image",
          "type": "string"
        },
        "verifier_mode": {
          "const": "separate",
          "default": "separate",
          "title": "Verifier Mode",
          "type": "string"
        }
      },
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_patch_paths": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Patch Paths",
          "type": "array"
        },
        "instruction": {
          "default": "instruction.md",
          "title": "Instruction",
          "type": "string"
        },
        "repo": {
          "default": "fixture/repo",
          "title": "Repo",
          "type": "string"
        },
        "solution_command": {
          "items": {
            "type": "string"
          },
          "title": "Solution Command",
          "type": "array"
        },
        "verifier_command": {
          "items": {
            "type": "string"
          },
          "title": "Verifier Command",
          "type": "array"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "GateConfig": {
      "additionalProperties": false,
      "properties": {
        "forbid_credential_access": {
          "default": true,
          "title": "Forbid Credential Access",
          "type": "boolean"
        },
        "forbid_data_corruption": {
          "default": true,
          "title": "Forbid Data Corruption",
          "type": "boolean"
        },
        "forbid_resource_leak": {
          "default": true,
          "title": "Forbid Resource Leak",
          "type": "boolean"
        },
        "forbid_silent_fallback": {
          "default": true,
          "title": "Forbid Silent Fallback",
          "type": "boolean"
        },
        "forbid_test_modification": {
          "default": true,
          "title": "Forbid Test Modification",
          "type": "boolean"
        }
      },
      "title": "GateConfig",
      "type": "object"
    },
    "KernelCaseSet": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "feedback_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Policy"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        }
      },
      "required": [
        "count"
      ],
      "title": "KernelCaseSet",
      "type": "object"
    },
    "KernelContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_backends": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Backends",
          "type": "array"
        },
        "anti_hack_policy": {
          "additionalProperties": true,
          "title": "Anti Hack Policy",
          "type": "object"
        },
        "artifact_surface": {
          "enum": [
            "device-kernel",
            "dispatcher",
            "framework-patch",
            "communication-program",
            "runtime-utility"
          ],
          "title": "Artifact Surface",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "enum": [
              "dispatch",
              "integration",
              "communication",
              "overlap",
              "topology",
              "graph-capture"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "dev_private_cases": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelCaseSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entrypoint": {
          "title": "Entrypoint",
          "type": "string"
        },
        "execution_scope": {
          "enum": [
            "single-device",
            "multi-device-intranode",
            "multi-node"
          ],
          "title": "Execution Scope",
          "type": "string"
        },
        "hidden_cases": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelCaseSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "measurement_domain": {
          "enum": [
            "device-time",
            "host-e2e",
            "request-e2e",
            "step-e2e"
          ],
          "title": "Measurement Domain",
          "type": "string"
        },
        "mechanism_policy": {
          "enum": [
            "strict-native",
            "approved-compositional",
            "framework-integrated",
            "direct-communication"
          ],
          "title": "Mechanism Policy",
          "type": "string"
        },
        "numerics": {
          "additionalProperties": true,
          "title": "Numerics",
          "type": "object"
        },
        "public_cases": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelCaseSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_entrypoint": {
          "title": "Reference Entrypoint",
          "type": "string"
        },
        "resource_contract": {
          "additionalProperties": true,
          "title": "Resource Contract",
          "type": "object"
        },
        "target_arch": {
          "items": {
            "type": "string"
          },
          "title": "Target Arch",
          "type": "array"
        },
        "workload_semantics": {
          "enum": [
            "operator",
            "fusion",
            "collective",
            "expert-parallel",
            "setup-utility"
          ],
          "title": "Workload Semantics",
          "type": "string"
        }
      },
      "required": [
        "entrypoint",
        "reference_entrypoint",
        "target_arch",
        "allowed_backends",
        "artifact_surface",
        "execution_scope",
        "workload_semantics",
        "mechanism_policy",
        "measurement_domain"
      ],
      "title": "KernelContract",
      "type": "object"
    },
    "KernelPerformanceConfig": {
      "additionalProperties": false,
      "properties": {
        "anchor_manifest_sha256": {
          "title": "Anchor Manifest Sha256",
          "type": "string"
        },
        "beyond_anchor_tolerance": {
          "default": 0.03,
          "minimum": 0,
          "title": "Beyond Anchor Tolerance",
          "type": "number"
        },
        "case_aggregation": {
          "default": "weighted-certified-only",
          "title": "Case Aggregation",
          "type": "string"
        },
        "min_headroom": {
          "default": 1.1,
          "exclusiveMinimum": 1,
          "title": "Min Headroom",
          "type": "number"
        },
        "primary": {
          "default": "anchor_score",
          "title": "Primary",
          "type": "string"
        },
        "report": {
          "items": {
            "type": "string"
          },
          "title": "Report",
          "type": "array"
        },
        "sampling_plan_sha256": {
          "title": "Sampling Plan Sha256",
          "type": "string"
        },
        "scoring_baseline_sha256": {
          "title": "Scoring Baseline Sha256",
          "type": "string"
        }
      },
      "required": [
        "scoring_baseline_sha256",
        "anchor_manifest_sha256",
        "sampling_plan_sha256"
      ],
      "title": "KernelPerformanceConfig",
      "type": "object"
    },
    "KernelRoleGraphRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "KernelRoleGraphRef",
      "type": "object"
    },
    "KernelRoleRequirements": {
      "additionalProperties": false,
      "properties": {
        "artifact_roles": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Roles",
          "type": "array"
        },
        "certification_roles": {
          "items": {
            "type": "string"
          },
          "title": "Certification Roles",
          "type": "array"
        },
        "fresh_replays": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Fresh Replays",
          "type": "integer"
        },
        "required_passes": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Required Passes",
          "type": "integer"
        },
        "search_roles": {
          "items": {
            "type": "string"
          },
          "title": "Search Roles",
          "type": "array"
        }
      },
      "title": "KernelRoleRequirements",
      "type": "object"
    },
    "KernelScoringConfig": {
      "additionalProperties": false,
      "properties": {
        "benchmark_cell_id": {
          "title": "Benchmark Cell Id",
          "type": "string"
        },
        "component_formula_origins": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Component Formula Origins",
          "type": "object"
        },
        "formula_origin": {
          "default": "infraswe-profile-template",
          "title": "Formula Origin",
          "type": "string"
        },
        "formula_parameters_sha256": {
          "title": "Formula Parameters Sha256",
          "type": "string"
        },
        "formula_version": {
          "title": "Formula Version",
          "type": "string"
        },
        "leaderboard_season": {
          "title": "Leaderboard Season",
          "type": "string"
        },
        "performance": {
          "$ref": "#/$defs/KernelPerformanceConfig"
        },
        "profile": {
          "enum": [
            "kernel-micro",
            "kernel-library",
            "kernel-integrated",
            "kernel-distributed"
          ],
          "title": "Profile",
          "type": "string"
        },
        "role_graph": {
          "$ref": "#/$defs/KernelRoleGraphRef"
        },
        "role_requirements": {
          "$ref": "#/$defs/KernelRoleRequirements"
        },
        "search": {
          "$ref": "#/$defs/KernelSearchConfig"
        }
      },
      "required": [
        "benchmark_cell_id",
        "leaderboard_season",
        "formula_version",
        "formula_parameters_sha256",
        "profile",
        "role_graph",
        "role_requirements",
        "performance"
      ],
      "title": "KernelScoringConfig",
      "type": "object"
    },
    "KernelSearchConfig": {
      "additionalProperties": false,
      "properties": {
        "dev_private_query_limit": {
          "default": 0,
          "minimum": 0,
          "title": "Dev Private Query Limit",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_candidates": {
          "default": 128,
          "exclusiveMinimum": 0,
          "title": "Max Candidates",
          "type": "integer"
        },
        "primary_budget_axis": {
          "default": "leased_device_seconds",
          "enum": [
            "leased_device_seconds",
            "wall_seconds",
            "tokens",
            "usd"
          ],
          "title": "Primary Budget Axis",
          "type": "string"
        },
        "publish_axes": {
          "items": {
            "type": "string"
          },
          "title": "Publish Axes",
          "type": "array"
        },
        "sealed_checkpoint_fractions": {
          "items": {
            "type": "number"
          },
          "title": "Sealed Checkpoint Fractions",
          "type": "array"
        },
        "sealed_feedback_during_episode": {
          "const": false,
          "default": false,
          "title": "Sealed Feedback During Episode",
          "type": "boolean"
        }
      },
      "title": "KernelSearchConfig",
      "type": "object"
    },
    "ReplayConfig": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "require_all": {
          "default": true,
          "title": "Require All",
          "type": "boolean"
        }
      },
      "title": "ReplayConfig",
      "type": "object"
    },
    "ScoringConfig": {
      "additionalProperties": false,
      "properties": {
        "kernel": {
          "anyOf": [
            {
              "$ref": "#/$defs/KernelScoringConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Reference Cost Usd",
          "type": "number"
        },
        "reference_wall_time_sec": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Reference Wall Time Sec",
          "type": "number"
        },
        "resource_metric": {
          "default": "resource_efficiency_ratio",
          "title": "Resource Metric",
          "type": "string"
        },
        "slo_metric": {
          "default": "slo_goodput_ratio",
          "title": "Slo Metric",
          "type": "string"
        }
      },
      "title": "ScoringConfig",
      "type": "object"
    },
    "TaskMetadata": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "infra-regression",
                "kernel-micro",
                "kernel-library",
                "kernel-integrated",
                "kernel-distributed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "level": {
          "default": "L1",
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "K0",
            "K1",
            "K2",
            "K3",
            "K4",
            "K5"
          ],
          "title": "Level",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "track": {
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "track",
        "repository",
        "base_commit"
      ],
      "title": "TaskMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/ArtifactConfig"
    },
    "budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentConfig"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "gates": {
      "$ref": "#/$defs/GateConfig"
    },
    "kernel_contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/KernelContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replay": {
      "$ref": "#/$defs/ReplayConfig"
    },
    "schema_version": {
      "default": "0.1",
      "enum": [
        "0.1",
        "0.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scoring": {
      "$ref": "#/$defs/ScoringConfig"
    },
    "task": {
      "$ref": "#/$defs/TaskMetadata"
    }
  },
  "required": [
    "task"
  ],
  "title": "TaskPackage",
  "type": "object"
}
