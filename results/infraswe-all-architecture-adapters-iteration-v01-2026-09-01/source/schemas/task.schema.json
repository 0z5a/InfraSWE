{
  "$defs": {
    "ArtifactConfig": {
      "additionalProperties": false,
      "properties": {
        "config_paths": {
          "items": {
            "type": "string"
          },
          "title": "Config Paths",
          "type": "array"
        },
        "require_clean_patch": {
          "default": true,
          "title": "Require Clean Patch",
          "type": "boolean"
        }
      },
      "title": "ArtifactConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_timeout_sec": {
          "default": 900,
          "exclusiveMinimum": 0,
          "title": "Agent Timeout Sec",
          "type": "integer"
        },
        "gpu_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Minutes",
          "type": "number"
        },
        "max_infra_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Infra Cost Usd",
          "type": "number"
        },
        "max_model_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Model Cost Usd",
          "type": "number"
        },
        "verifier_timeout_sec": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Verifier Timeout Sec",
          "type": "integer"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_image": {
          "default": "python:3.12-slim",
          "title": "Agent Image",
          "type": "string"
        },
        "agent_mode": {
          "default": "docker",
          "enum": [
            "local",
            "docker",
            "vm",
            "kubernetes"
          ],
          "title": "Agent Mode",
          "type": "string"
        },
        "gpu_count": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Gpu Count",
          "type": "integer"
        },
        "network": {
          "default": "deny",
          "enum": [
            "deny",
            "allowlist"
          ],
          "title": "Network",
          "type": "string"
        },
        "profile": {
          "default": "cpu-small",
          "title": "Profile",
          "type": "string"
        },
        "shm_size": {
          "default": "256m",
          "pattern": "^[1-9][0-9]*(?:[kKmMgG])$",
          "title": "Shm Size",
          "type": "string"
        },
        "verifier_image": {
          "default": "python:3.12-slim",
          "title": "Verifier Image",
          "type": "string"
        },
        "verifier_mode": {
          "const": "separate",
          "default": "separate",
          "title": "Verifier Mode",
          "type": "string"
        }
      },
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_patch_paths": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Patch Paths",
          "type": "array"
        },
        "instruction": {
          "default": "instruction.md",
          "title": "Instruction",
          "type": "string"
        },
        "repo": {
          "default": "fixture/repo",
          "title": "Repo",
          "type": "string"
        },
        "solution_command": {
          "items": {
            "type": "string"
          },
          "title": "Solution Command",
          "type": "array"
        },
        "verifier_command": {
          "items": {
            "type": "string"
          },
          "title": "Verifier Command",
          "type": "array"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "GateConfig": {
      "additionalProperties": false,
      "properties": {
        "forbid_credential_access": {
          "default": true,
          "title": "Forbid Credential Access",
          "type": "boolean"
        },
        "forbid_data_corruption": {
          "default": true,
          "title": "Forbid Data Corruption",
          "type": "boolean"
        },
        "forbid_resource_leak": {
          "default": true,
          "title": "Forbid Resource Leak",
          "type": "boolean"
        },
        "forbid_silent_fallback": {
          "default": true,
          "title": "Forbid Silent Fallback",
          "type": "boolean"
        },
        "forbid_test_modification": {
          "default": true,
          "title": "Forbid Test Modification",
          "type": "boolean"
        }
      },
      "title": "GateConfig",
      "type": "object"
    },
    "ReplayConfig": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "require_all": {
          "default": true,
          "title": "Require All",
          "type": "boolean"
        }
      },
      "title": "ReplayConfig",
      "type": "object"
    },
    "ScoringConfig": {
      "additionalProperties": false,
      "properties": {
        "reference_cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Reference Cost Usd",
          "type": "number"
        },
        "reference_wall_time_sec": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "title": "Reference Wall Time Sec",
          "type": "number"
        },
        "resource_metric": {
          "default": "resource_efficiency_ratio",
          "title": "Resource Metric",
          "type": "string"
        },
        "slo_metric": {
          "default": "slo_goodput_ratio",
          "title": "Slo Metric",
          "type": "string"
        }
      },
      "title": "ScoringConfig",
      "type": "object"
    },
    "TaskMetadata": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "default": "L1",
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "title": "Level",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "track": {
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "track",
        "repository",
        "base_commit"
      ],
      "title": "TaskMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/ArtifactConfig"
    },
    "budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentConfig"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "gates": {
      "$ref": "#/$defs/GateConfig"
    },
    "replay": {
      "$ref": "#/$defs/ReplayConfig"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring": {
      "$ref": "#/$defs/ScoringConfig"
    },
    "task": {
      "$ref": "#/$defs/TaskMetadata"
    }
  },
  "required": [
    "task"
  ],
  "title": "TaskPackage",
  "type": "object"
}
