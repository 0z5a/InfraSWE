FROM pytorch/pytorch@sha256:a7103283ea7113e10ae5d014bd2342acebda0bc53164b2f7b1dd6eb7a766bdb6

ARG FLASH_ATTENTION_COMMIT=ce088ab9ce0fc0434dcd8afa0a791da9fcc3a820
ARG FLASH_ATTN_CUDA_ARCHS=80
ENV FLASH_ATTENTION_DISABLE_DROPOUT=TRUE \
    MAX_JOBS=8 \
    NVCC_THREADS=2 \
    PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir einops ninja packaging psutil && \
    git clone --filter=blob:none https://github.com/Dao-AILab/flash-attention.git /opt/flash-attention && \
    cd /opt/flash-attention && \
    git checkout "$FLASH_ATTENTION_COMMIT" && \
    git submodule update --init --depth 1 csrc/cutlass && \
    FLASH_ATTN_CUDA_ARCHS="$FLASH_ATTN_CUDA_ARCHS" \
    python -m pip install --no-cache-dir --no-build-isolation .

WORKDIR /workspace
