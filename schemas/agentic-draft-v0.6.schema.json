{
  "$defs": {
    "RolloutBudget": {
      "additionalProperties": false,
      "properties": {
        "environment_gpu_s": {
          "minimum": 0,
          "title": "Environment Gpu S",
          "type": "integer"
        },
        "generated_tokens": {
          "minimum": 1,
          "title": "Generated Tokens",
          "type": "integer"
        },
        "model_calls": {
          "minimum": 1,
          "title": "Model Calls",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_time_s": {
          "minimum": 1,
          "title": "Wall Time S",
          "type": "integer"
        }
      },
      "required": [
        "generated_tokens",
        "model_calls",
        "tool_calls",
        "wall_time_s",
        "environment_gpu_s"
      ],
      "title": "RolloutBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_profile_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Algorithm Profile Sha256",
      "type": "string"
    },
    "candidate_score_formula_unchanged": {
      "const": true,
      "default": true,
      "title": "Candidate Score Formula Unchanged",
      "type": "boolean"
    },
    "credit_profile_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Credit Profile Sha256",
      "type": "string"
    },
    "draft_id": {
      "title": "Draft Id",
      "type": "string"
    },
    "draft_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Draft Sha256",
      "type": "string"
    },
    "feedback_profile_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Feedback Profile Sha256",
      "type": "string"
    },
    "measurement_isolation": {
      "enum": [
        "MI0",
        "MI1",
        "MI2",
        "MI3"
      ],
      "title": "Measurement Isolation",
      "type": "string"
    },
    "mixed_policy_episode": {
      "const": "forbidden",
      "default": "forbidden",
      "title": "Mixed Policy Episode",
      "type": "string"
    },
    "policy_cell_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Cell Sha256",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "reward_profile_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reward Profile Sha256",
      "type": "string"
    },
    "rollout_budget": {
      "$ref": "#/$defs/RolloutBudget"
    },
    "rollout_fabric_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rollout Fabric Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "0.6",
      "default": "0.6",
      "title": "Schema Version",
      "type": "string"
    },
    "task_seal_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Seal Sha256",
      "type": "string"
    },
    "task_split": {
      "enum": [
        "train",
        "dev",
        "heldout",
        "official"
      ],
      "title": "Task Split",
      "type": "string"
    },
    "track": {
      "enum": [
        "frozen-agent-artifact",
        "external-policy-learning",
        "online-adaptation",
        "agentic-rl-training",
        "rl-systems",
        "task-authoring-and-verifier-audit"
      ],
      "title": "Track",
      "type": "string"
    },
    "training_reward_affects_official_score": {
      "const": false,
      "default": false,
      "title": "Training Reward Affects Official Score",
      "type": "boolean"
    }
  },
  "required": [
    "draft_id",
    "revision",
    "task_seal_sha256",
    "task_split",
    "track",
    "policy_cell_sha256",
    "rollout_budget",
    "algorithm_profile_sha256",
    "reward_profile_sha256",
    "credit_profile_sha256",
    "feedback_profile_sha256",
    "rollout_fabric_sha256",
    "measurement_isolation",
    "draft_sha256"
  ],
  "title": "AgenticDraftSpec",
  "type": "object"
}
