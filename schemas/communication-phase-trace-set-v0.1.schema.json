          "type": "integer"
        },
        "api_return_timestamp_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Return Timestamp Ns"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "communicator_sequence_id": {
          "minimum": 0,
          "title": "Communicator Sequence Id",
          "type": "integer"
        },
        "completion_timestamp_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Timestamp Ns"
        },
        "consumer_timestamp_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumer Timestamp Ns"
        },
        "direction": {
          "minLength": 1,
          "title": "Direction",
          "type": "string"
        },
        "framework": {
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "gpu_end_timestamp_ns": {
          "minimum": 0,
          "title": "Gpu End Timestamp Ns",
          "type": "integer"
        },
        "gpu_start_timestamp_ns": {
          "minimum": 0,
          "title": "Gpu Start Timestamp Ns",
          "type": "integer"
        },
        "layer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "local_rank": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Rank"
        },
        "logical_operation_id": {
          "minLength": 1,
          "title": "Logical Operation Id",
          "type": "string"
        },
        "message_bytes": {
          "exclusiveMinimum": 0,
          "title": "Message Bytes",
          "type": "integer"
        },
        "microbatch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microbatch"
        },
        "node": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "pair_role": {
          "enum": [
            "a",
            "b"
