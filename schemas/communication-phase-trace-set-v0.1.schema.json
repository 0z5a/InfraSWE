        "framework",
        "run_id",
        "rank",
        "world_size",
        "step",
        "direction",
        "operation",
        "logical_operation_id",
        "pair_id",
        "pair_role",
        "process_group_id",
        "process_group_ranks",
        "communicator_sequence_id",
        "stream_id",
        "message_bytes",
        "api_launch_timestamp_ns",
        "gpu_start_timestamp_ns",
        "gpu_end_timestamp_ns",
        "transport",
        "topology_class"
      ],
      "title": "CommunicationPhaseTraceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete trace for one policy run inside one sealed comparison cell.",
  "properties": {
    "cell_identity_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cell Identity Sha256",
      "type": "string"
    },
    "clock_sync_error_bound_us": {
      "minimum": 0,
      "title": "Clock Sync Error Bound Us",
      "type": "number"
    },
    "evidence_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Digests",
      "type": "array"
    },
    "framework": {
      "minLength": 1,
      "title": "Framework",
      "type": "string"
    },
    "gpu_timestamp_semantics": {
      "enum": [
        "kernel-observed",
        "event-bracket"
      ],
      "title": "Gpu Timestamp Semantics",
      "type": "string"
    },
    "isolated_latency_ms_by_operation": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "title": "Isolated Latency Ms By Operation",
      "type": "object"
    },
    "policy": {
      "minLength": 1,
      "title": "Policy",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/CommunicationPhaseTraceRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "step_time_ms": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "title": "Step Time Ms",
      "type": "array"
    },
    "timestamp_domain": {
      "minLength": 1,
      "title": "Timestamp Domain",
      "type": "string"
    },
    "workload_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Workload Sha256",
      "type": "string"
    },
    "world_size": {
      "minimum": 2,
      "title": "World Size",
      "type": "integer"
    }
  },
  "required": [
    "framework",
    "run_id",
    "policy",
    "world_size",
    "cell_identity_sha256",
    "workload_sha256",
    "timestamp_domain",
    "gpu_timestamp_semantics",
    "clock_sync_error_bound_us",
    "records",
    "evidence_digests"
  ],
  "title": "CommunicationPhaseTraceSet",
  "type": "object"
}
