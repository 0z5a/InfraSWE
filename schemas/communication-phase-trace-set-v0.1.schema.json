        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "requested_offset_us": {
          "default": 0.0,
          "title": "Requested Offset Us",
          "type": "number"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "stream_id": {
          "minLength": 1,
          "title": "Stream Id",
          "type": "string"
        },
        "topology_class": {
          "minLength": 1,
          "title": "Topology Class",
          "type": "string"
        },
        "transport": {
          "minLength": 1,
          "title": "Transport",
          "type": "string"
        },
        "world_size": {
          "minimum": 2,
