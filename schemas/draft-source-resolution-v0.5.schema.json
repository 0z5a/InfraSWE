{
  "$defs": {
    "CandidateSelectionRequest": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "cuda",
          "enum": [
            "generic",
            "cuda",
            "rocm",
            "triton"
          ],
          "title": "Backend",
          "type": "string"
        },
        "operator_family": {
          "default": "generic",
          "enum": [
            "generic",
            "attention-training",
            "attention-inference-prefill",
            "attention-inference-decode",
            "paged-attention",
            "dense-gemm",
            "grouped-moe-gemm",
            "training-fused-ops",
            "quantization",
            "communication-collective",
            "moe-dispatch-combine",
            "gpu-initiated-communication"
          ],
          "title": "Operator Family",
          "type": "string"
        },
        "phase": {
          "default": "generic",
          "enum": [
            "generic",
            "training",
            "inference",
            "communication"
          ],
          "title": "Phase",
          "type": "string"
        },
        "requested_primary_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Primary Host"
        }
      },
      "title": "CandidateSelectionRequest",
      "type": "object"
    },
    "CandidateSelectionTrace": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "result": {
          "enum": [
            "matched",
            "not-matched",
            "selected",
            "fallback",
            "preserved"
          ],
          "title": "Result",
          "type": "string"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step",
        "question",
        "result",
        "explanation"
      ],
      "title": "CandidateSelectionTrace",
      "type": "object"
    },
    "DefaultCandidateResolution": {
      "additionalProperties": false,
      "properties": {
        "compilation_started": {
          "const": false,
          "default": false,
          "title": "Compilation Started",
          "type": "boolean"
        },
        "coverage_targets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Coverage Targets",
          "type": "array"
        },
        "learned_model_used": {
          "const": false,
          "default": false,
          "title": "Learned Model Used",
          "type": "boolean"
        },
        "matched_rule_id": {
          "title": "Matched Rule Id",
          "type": "string"
        },
        "oracles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Oracles",
          "type": "array"
        },
        "primary_host": {
          "title": "Primary Host",
          "type": "string"
        },
        "primary_peer_impl": {
          "title": "Primary Peer Impl",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/CandidateSelectionRequest"
        },
        "required_tests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Tests",
          "type": "array"
        },
        "schema_version": {
          "const": "0.5",
          "default": "0.5",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Hosts",
          "type": "array"
        },
        "secondary_peer_impls": {
          "items": {
            "type": "string"
          },
          "title": "Secondary Peer Impls",
          "type": "array"
        },
        "selection_side_effects": {
          "const": "metadata-only-no-import-no-build",
          "default": "metadata-only-no-import-no-build",
          "title": "Selection Side Effects",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CandidateSelectionTrace"
          },
          "minItems": 1,
          "title": "Trace",
          "type": "array"
        },
        "weighted_score_used": {
          "const": false,
          "default": false,
          "title": "Weighted Score Used",
          "type": "boolean"
        },
        "workload_sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Workload Sources",
          "type": "array"
        }
      },
      "required": [
        "registry_sha256",
        "request",
        "matched_rule_id",
        "oracles",
        "primary_peer_impl",
        "primary_host",
        "workload_sources",
        "coverage_targets",
        "required_tests",
        "trace"
      ],
      "title": "DefaultCandidateResolution",
      "type": "object"
    },
    "DraftAcceptanceContract": {
      "additionalProperties": false,
      "properties": {
        "hidden_probe_policy_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hidden Probe Policy Sha256",
          "type": "string"
        },
        "human_review_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Review Sha256"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "probe_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Probe Set Sha256",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "human-reviewed",
            "sealed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "path",
        "sha256",
        "probe_set_sha256",
        "hidden_probe_policy_sha256"
      ],
      "title": "DraftAcceptanceContract",
      "type": "object"
    },
    "DraftBaseline": {
      "additionalProperties": false,
      "properties": {
        "advisory_reference_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advisory Reference Profile"
        },
        "mode": {
          "enum": [
            "target-head",
            "pinned-reference"
          ],
          "title": "Mode",
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "revision"
      ],
      "title": "DraftBaseline",
      "type": "object"
    },
    "DraftBenchmarkLoop": {
      "additionalProperties": false,
      "properties": {
        "affected_case_selection": {
          "const": "required",
          "default": "required",
          "title": "Affected Case Selection",
          "type": "string"
        },
        "affected_stage_max_official_fraction": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Affected Stage Max Official Fraction",
          "type": "number"
        },
        "benchmark_budget_policy_id": {
          "title": "Benchmark Budget Policy Id",
          "type": "string"
        },
        "early_exit_on_hard_gate": {
          "default": false,
          "title": "Early Exit On Hard Gate",
          "type": "boolean"
        },
        "evaluation_scope": {
          "default": "full",
          "enum": [
            "full",
            "staged"
          ],
          "title": "Evaluation Scope",
          "type": "string"
        },
        "evidence_policy_id": {
          "title": "Evidence Policy Id",
          "type": "string"
        },
        "fast_stage_max_official_fraction": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Fast Stage Max Official Fraction",
          "type": "number"
        },
        "official_replays": {
          "default": 7,
          "maximum": 10,
          "minimum": 5,
          "title": "Official Replays",
          "type": "integer"
        },
        "precompile": {
          "$ref": "#/$defs/DraftPrecompilePolicy"
        }
      },
      "required": [
        "benchmark_budget_policy_id",
        "evidence_policy_id"
      ],
      "title": "DraftBenchmarkLoop",
      "type": "object"
    },
    "DraftCandidate": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "generic",
          "enum": [
            "generic",
            "cuda",
            "rocm",
            "triton"
          ],
          "title": "Backend",
          "type": "string"
        },
        "entrypoints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Entrypoints",
          "type": "array"
        },
        "implementation_kind": {
          "enum": [
            "cuda-native",
            "hip-native",
            "cann-native",
            "triton-pure",
            "framework"
          ],
          "title": "Implementation Kind",
          "type": "string"
        },
        "intent": {
          "enum": [
            "replace",
            "add-fastpath",
            "repair",
            "port",
            "integrate"
          ],
          "title": "Intent",
          "type": "string"
        },
        "kind": {
          "enum": [
            "git-diff",
            "source-tree",
            "package",
            "generated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operator_family": {
          "default": "generic",
          "enum": [
            "generic",
            "attention-training",
            "attention-inference-prefill",
            "attention-inference-decode",
            "paged-attention",
            "dense-gemm",
            "grouped-moe-gemm",
            "training-fused-ops",
            "quantization",
            "communication-collective",
            "moe-dispatch-combine",
            "gpu-initiated-communication"
          ],
          "title": "Operator Family",
          "type": "string"
        },
        "phase": {
          "default": "generic",
          "enum": [
            "generic",
            "training",
            "inference",
            "communication"
          ],
          "title": "Phase",
          "type": "string"
        },
        "primary_host_candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Host Candidate"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "revision",
        "intent",
        "implementation_kind",
        "entrypoints"
      ],
      "title": "DraftCandidate",
      "type": "object"
    },
    "DraftDeployment": {
      "additionalProperties": false,
      "properties": {
        "optional_cells": {
          "items": {
            "type": "string"
          },
          "title": "Optional Cells",
          "type": "array"
        },
        "request_or_step_protocol": {
          "$ref": "#/$defs/VersionedArtifactRef"
        },
        "required_cells": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Cells",
          "type": "array"
        },
        "workload_portfolio": {
          "$ref": "#/$defs/VersionedArtifactRef"
        }
      },
      "required": [
        "workload_portfolio",
        "required_cells",
        "request_or_step_protocol"
      ],
      "title": "DraftDeployment",
      "type": "object"
    },
    "DraftMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "D0-created",
            "D1-target-bound",
            "D2-precedents-retrieved",
            "D3-contract-proposed",
            "D4-human-reviewed",
            "D5-fast-loop",
            "D6-sealed",
            "D7-official-evaluation",
            "D8-decided",
            "D9-archived"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "created_by"
      ],
      "title": "DraftMetadata",
      "type": "object"
    },
    "DraftObjectiveBinding": {
      "additionalProperties": false,
      "properties": {
        "edge_ecosystem_policy": {
          "enum": [
            "roadmap",
            "release-gate",
            "maintenance-only",
            "experimental",
            "out-of-scope"
          ],
          "title": "Edge Ecosystem Policy",
          "type": "string"
        },
        "profile_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Set Sha256",
          "type": "string"
        }
      },
      "required": [
        "edge_ecosystem_policy",
        "profile_set_sha256"
      ],
      "title": "DraftObjectiveBinding",
      "type": "object"
    },
    "DraftPrecompilePolicy": {
      "additionalProperties": false,
      "description": "Draft-local switch for keeping unavoidable compilation out of timed cases.",
      "properties": {
        "cache_miss_action": {
          "const": "precompile-before-timed-cases",
          "default": "precompile-before-timed-cases",
          "title": "Cache Miss Action",
          "type": "string"
        },
        "cache_policy": {
          "const": "content-addressed-evidence-identity",
          "default": "content-addressed-evidence-identity",
          "title": "Cache Policy",
          "type": "string"
        },
        "mode": {
          "default": "auto",
          "enum": [
            "off",
            "auto"
          ],
          "title": "Mode",
          "type": "string"
        },
        "steady_state_compile_allowed": {
          "const": false,
          "default": false,
          "title": "Steady State Compile Allowed",
          "type": "boolean"
        },
        "timing_phases": {
          "items": {
            "enum": [
              "precompile",
              "cold-start",
              "steady-state"
            ],
            "type": "string"
          },
          "title": "Timing Phases",
          "type": "array"
        },
        "trigger": {
          "const": "when-compilation-required",
          "default": "when-compilation-required",
          "title": "Trigger",
          "type": "string"
        }
      },
      "title": "DraftPrecompilePolicy",
      "type": "object"
    },
    "DraftRetrieval": {
      "additionalProperties": false,
      "properties": {
        "corpus_cutoff": {
          "format": "date-time",
          "title": "Corpus Cutoff",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "precedent_set_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedent Set Sha256"
        },
        "sources": {
          "items": {
            "enum": [
              "target-code",
              "merged-prs",
              "rejected-prs",
              "reverted-prs",
              "review-comments",
              "issues",
              "ci-failures",
              "release-notes"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "corpus_cutoff",
        "sources"
      ],
      "title": "DraftRetrieval",
      "type": "object"
    },
    "DraftScoringPolicy": {
      "additionalProperties": false,
      "properties": {
        "evaluation_engine": {
          "default": "infraswe",
          "enum": [
            "infraswe",
            "external"
          ],
          "title": "Evaluation Engine",
          "type": "string"
        },
        "formula_template_id": {
          "enum": [
            "project-fit-kernel-v0.5",
            "project-fit-triton-pure-v0.5"
          ],
          "title": "Formula Template Id",
          "type": "string"
        },
        "official_scoring_requires_seal": {
          "const": true,
          "default": true,
          "title": "Official Scoring Requires Seal",
          "type": "boolean"
        },
        "project_season": {
          "title": "Project Season",
          "type": "string"
        },
        "provisional_scoring_allowed": {
          "default": true,
          "title": "Provisional Scoring Allowed",
          "type": "boolean"
        },
        "seal_by_default": {
          "default": true,
          "title": "Seal By Default",
          "type": "boolean"
        }
      },
      "required": [
        "formula_template_id",
        "project_season"
      ],
      "title": "DraftScoringPolicy",
      "type": "object"
    },
    "DraftSpec": {
      "additionalProperties": false,
      "properties": {
        "acceptance_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAcceptanceContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftBaseline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "benchmark_loop": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftBenchmarkLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate": {
          "$ref": "#/$defs/DraftCandidate"
        },
        "default_candidates": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultCandidateResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftDeployment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "draft": {
          "$ref": "#/$defs/DraftMetadata"
        },
        "project_objectives": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftObjectiveBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftRetrieval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "0.5",
          "default": "0.5",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftScoringPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "draft",
        "candidate"
      ],
      "title": "DraftSpec",
      "type": "object"
    },
    "DraftTarget": {
      "additionalProperties": false,
      "properties": {
        "catalog_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Profile"
        },
        "mode": {
          "enum": [
            "catalog",
            "repository"
          ],
          "title": "Mode",
          "type": "string"
        },
        "project_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Project Profile Sha256",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "repository",
        "revision",
        "project_profile_sha256"
      ],
      "title": "DraftTarget",
      "type": "object"
    },
    "EdgeEcosystemObjective": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "policy": {
          "enum": [
            "roadmap",
            "release-gate",
            "maintenance-only",
            "experimental",
            "out-of-scope"
          ],
          "title": "Policy",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/EdgeProfileObjective"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "required": [
        "owner",
        "policy"
      ],
      "title": "EdgeEcosystemObjective",
      "type": "object"
    },
    "EdgeProfileObjective": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "required_for_release": {
          "default": false,
          "title": "Required For Release",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "planned",
            "maintenance-only",
            "experimental",
            "out-of-scope"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Release"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "EdgeProfileObjective",
      "type": "object"
    },
    "ProjectObjectives": {
      "additionalProperties": false,
      "properties": {
        "edge_ecosystem": {
          "$ref": "#/$defs/EdgeEcosystemObjective"
        }
      },
      "required": [
        "edge_ecosystem"
      ],
      "title": "ProjectObjectives",
      "type": "object"
    },
    "ProjectOwnership": {
      "additionalProperties": false,
      "properties": {
        "last_reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reviewed At"
        },
        "maintainers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Maintainers",
          "type": "array"
        },
        "review_required": {
          "default": 1,
