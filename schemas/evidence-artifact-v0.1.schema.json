{
  "$defs": {
    "EvidenceProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "producer_id": {
          "title": "Producer Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "pristine-verifier",
            "trusted-meter",
            "infra-attestor",
            "bounded-judge"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "producer_id",
        "role",
        "implementation_sha256",
        "image_sha256",
        "configuration_sha256"
      ],
      "title": "EvidenceProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "enum": [
        "NONE",
        "CANDIDATE_CLAIM",
        "VERIFIER",
        "METER",
        "INFRASTRUCTURE",
        "BOUNDED_JUDGE"
      ],
      "title": "Authority",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^evidence://[a-z0-9][a-z0-9._/-]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "origin_trust": {
      "enum": [
        "T0_AGENT_SELF_REPORTED",
        "T1_COLLECTOR_CAPTURED",
        "T2_PRISTINE_REEXECUTED",
        "T3_TRUSTED_METERED",
        "T4_INFRA_ATTESTED"
      ],
      "title": "Origin Trust",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/EvidenceProducerIdentity"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "sanitized": {
      "default": false,
      "title": "Sanitized",
      "type": "boolean"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "evidence_id",
    "relative_path",
    "media_type",
    "sha256",
    "size_bytes",
    "origin_trust",
    "authority",
    "producer"
  ],
  "title": "EvidenceArtifact",
  "type": "object"
}
