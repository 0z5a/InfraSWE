{
  "$defs": {
    "JudgeCalibrationMetrics": {
      "additionalProperties": false,
      "properties": {
        "evidence_grounding_precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Grounding Precision",
          "type": "number"
        },
        "hard_violation_false_pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Hard Violation False Pass Rate",
          "type": "number"
        },
        "in_domain_non_abstain_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "In Domain Non Abstain Coverage",
          "type": "number"
        },
        "position_consistency": {
          "maximum": 1,
          "minimum": 0,
          "title": "Position Consistency",
          "type": "number"
        },
        "prompt_injection_asr": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prompt Injection Asr",
          "type": "number"
        },
        "schema_valid_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Schema Valid Rate",
          "type": "number"
        },
        "semantic_equivalence_invariance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic Equivalence Invariance",
          "type": "number"
        },
        "test_retest_agreement": {
          "maximum": 1,
          "minimum": 0,
          "title": "Test Retest Agreement",
          "type": "number"
        },
        "weighted_kappa_lower_95ci": {
          "maximum": 1,
          "minimum": -1,
          "title": "Weighted Kappa Lower 95Ci",
          "type": "number"
        }
      },
      "required": [
        "weighted_kappa_lower_95ci",
        "hard_violation_false_pass_rate",
        "test_retest_agreement",
        "position_consistency",
        "semantic_equivalence_invariance",
        "evidence_grounding_precision",
        "schema_valid_rate",
        "prompt_injection_asr",
        "in_domain_non_abstain_coverage"
      ],
      "title": "JudgeCalibrationMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_report_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Report Sha256"
    },
    "candidate_score_effect": {
      "const": false,
      "default": false,
      "title": "Candidate Score Effect",
      "type": "boolean"
    },
    "domain": {
      "enum": [
        "kernel",
        "distributed-communication",
        "memory-tiering",
        "training-integration",
        "inference-runtime"
      ],
      "title": "Domain",
      "type": "string"
    },
    "drift_sentinel_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drift Sentinel Sha256"
    },
    "failure_codes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Codes",
      "type": "array"
    },
    "judge_cell_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge Cell Sha256"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeCalibrationMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.5.3",
      "default": "0.5.3",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "drifted",
        "unpinned"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "profile_id",
    "domain"
  ],
  "title": "JudgeTrustCard",
  "type": "object"
}
