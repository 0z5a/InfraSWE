{
  "$defs": {
    "DraftAcceptanceContract": {
      "additionalProperties": false,
      "properties": {
        "hidden_probe_policy_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hidden Probe Policy Sha256",
          "type": "string"
        },
        "human_review_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Review Sha256"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "probe_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Probe Set Sha256",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "human-reviewed",
            "sealed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "path",
        "sha256",
        "probe_set_sha256",
        "hidden_probe_policy_sha256"
      ],
      "title": "DraftAcceptanceContract",
      "type": "object"
    },
    "DraftMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "D0-created",
            "D1-target-bound",
            "D2-precedents-retrieved",
            "D3-contract-proposed",
            "D4-human-reviewed",
            "D5-fast-loop",
            "D6-sealed",
            "D7-official-evaluation",
            "D8-decided",
            "D9-archived"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "created_by"
      ],
      "title": "DraftMetadata",
      "type": "object"
    },
    "DraftTarget": {
      "additionalProperties": false,
      "properties": {
        "catalog_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Profile"
        },
        "mode": {
          "enum": [
            "catalog",
            "repository"
          ],
          "title": "Mode",
          "type": "string"
        },
        "project_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Project Profile Sha256",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "repository",
        "revision",
        "project_profile_sha256"
      ],
      "title": "DraftTarget",
      "type": "object"
    },
    "MemoryTier": {
      "additionalProperties": false,
      "properties": {
        "capacity_bytes": {
          "exclusiveMinimum": 0,
          "title": "Capacity Bytes",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "device",
            "host-pinned",
            "host-pageable",
            "cxl",
            "nvme",
            "remote-memory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "numa_node": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numa Node"
        },
        "policy": {
          "enum": [
            "required",
            "optional",
            "explicit-unsupported",
            "roadmap"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "capacity_bytes",
        "policy"
      ],
      "title": "MemoryTier",
      "type": "object"
    },
    "MemoryTierCapacity": {
      "additionalProperties": false,
      "properties": {
        "device_budget_bytes": {
          "exclusiveMinimum": 0,
          "title": "Device Budget Bytes",
          "type": "integer"
        },
        "host_pageable_budget_bytes": {
          "minimum": 0,
          "title": "Host Pageable Budget Bytes",
          "type": "integer"
        },
        "host_pinned_budget_bytes": {
          "minimum": 0,
          "title": "Host Pinned Budget Bytes",
          "type": "integer"
        },
        "queue_limit": {
          "exclusiveMinimum": 0,
          "title": "Queue Limit",
          "type": "integer"
        },
        "unbounded_growth": {
          "const": false,
          "default": false,
          "title": "Unbounded Growth",
          "type": "boolean"
        }
      },
      "required": [
        "device_budget_bytes",
        "host_pinned_budget_bytes",
        "host_pageable_budget_bytes",
        "queue_limit"
      ],
      "title": "MemoryTierCapacity",
      "type": "object"
    },
    "MemoryTierCellIdentity": {
      "additionalProperties": false,
      "properties": {
        "allocator": {
          "title": "Allocator",
          "type": "string"
        },
        "background_load_policy": {
          "title": "Background Load Policy",
          "type": "string"
        },
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "cpu_affinity": {
          "title": "Cpu Affinity",
          "type": "string"
        },
        "cpu_model": {
          "title": "Cpu Model",
          "type": "string"
        },
        "cpu_socket_count": {
          "minimum": 1,
          "title": "Cpu Socket Count",
          "type": "integer"
        },
        "driver_runtime": {
          "title": "Driver Runtime",
          "type": "string"
        },
        "framework": {
          "title": "Framework",
          "type": "string"
        },
        "gpu_count": {
          "minimum": 1,
          "title": "Gpu Count",
          "type": "integer"
        },
        "gpu_memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Gpu Memory Bytes",
          "type": "integer"
        },
        "gpu_model": {
          "title": "Gpu Model",
          "type": "string"
        },
        "gpu_topology_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Gpu Topology Sha256",
          "type": "string"
        },
        "host_memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Host Memory Bytes",
          "type": "integer"
        },
        "host_page_policy": {
          "title": "Host Page Policy",
          "type": "string"
        },
        "interconnect": {
          "title": "Interconnect",
          "type": "string"
        },
        "numa_policy": {
          "title": "Numa Policy",
          "type": "string"
        },
        "numa_topology_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Numa Topology Sha256",
          "type": "string"
        },
        "os_kernel": {
          "title": "Os Kernel",
          "type": "string"
        },
        "pinned_policy": {
          "enum": [
            "required",
            "optional",
            "forbidden"
          ],
          "title": "Pinned Policy",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "gpu_model",
        "gpu_count",
        "gpu_topology_sha256",
        "gpu_memory_bytes",
        "cpu_model",
        "cpu_socket_count",
        "numa_topology_sha256",
        "host_memory_bytes",
        "cpu_affinity",
        "numa_policy",
        "interconnect",
        "pinned_policy",
        "host_page_policy",
        "os_kernel",
        "driver_runtime",
        "framework",
        "allocator",
        "background_load_policy"
      ],
      "title": "MemoryTierCellIdentity",
      "type": "object"
    },
    "MemoryTierDeployment": {
      "additionalProperties": false,
      "properties": {
        "concurrency_protocol_id": {
          "const": "memory-tiering-load-normalized-v1",
          "default": "memory-tiering-load-normalized-v1",
          "title": "Concurrency Protocol Id",
          "type": "string"
        },
        "optional_cells": {
          "items": {
            "$ref": "#/$defs/MemoryTierCellIdentity"
          },
          "title": "Optional Cells",
          "type": "array"
        },
        "performance_mode": {
          "enum": [
            "fixed-workload",
            "fixed-device-budget",
            "capacity-enable"
          ],
          "title": "Performance Mode",
          "type": "string"
        },
        "required_cells": {
          "items": {
            "$ref": "#/$defs/MemoryTierCellIdentity"
          },
          "minItems": 1,
          "title": "Required Cells",
          "type": "array"
        },
        "residency_target_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Residency Target Sha256",
          "type": "string"
        },
        "service_target_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Service Target Sha256",
          "type": "string"
        },
        "transfer_target_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Transfer Target Sha256",
          "type": "string"
        },
        "workload_portfolio_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workload Portfolio Sha256",
          "type": "string"
        }
      },
      "required": [
        "performance_mode",
        "workload_portfolio_sha256",
        "required_cells",
        "service_target_sha256",
        "residency_target_sha256",
        "transfer_target_sha256"
      ],
      "title": "MemoryTierDeployment",
      "type": "object"
    },
    "MemoryTierScoringPolicy": {
      "additionalProperties": false,
      "properties": {
        "backend_or_tier_count_score": {
