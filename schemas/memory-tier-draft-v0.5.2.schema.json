            "activation-cpu-offload-v1",
            "checkpoint-staging-cpu-offload-v1"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "request_or_step_isolation": {
          "const": true,
          "default": true,
          "title": "Request Or Step Isolation",
          "type": "boolean"
        },
        "residency_owner": {
          "title": "Residency Owner",
          "type": "string"
        },
        "source_tier_id": {
          "title": "Source Tier Id",
          "type": "string"
        },
        "teardown_quiescence": {
          "const": true,
          "default": true,
          "title": "Teardown Quiescence",
          "type": "boolean"
        },
