          "type": "string"
        },
        "cpu_offload_score": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Cpu Offload Score",
          "type": "string"
        },
        "deployability_template_id": {
          "const": "deployability-v0.4",
          "default": "deployability-v0.4",
          "title": "Deployability Template Id",
          "type": "string"
        },
        "generic_cross_platform_score": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Generic Cross Platform Score",
          "type": "string"
        },
        "memory_tier_count_score": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Memory Tier Count Score",
