        "target_state": {
          "enum": [
            "DEVICE_RESIDENT",
            "EVICTING",
            "HOST_RESIDENT",
            "PREFETCHING",
            "DEVICE_READY",
            "INVALIDATED",
            "FAILED",
            "FREED"
