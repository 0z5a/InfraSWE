{
  "$defs": {
    "AutomationCoverage": {
      "additionalProperties": false,
      "properties": {
        "automatic_cases": {
          "minimum": 0,
          "title": "Automatic Cases",
          "type": "integer"
        },
        "human_assisted_cases": {
          "minimum": 0,
          "title": "Human Assisted Cases",
          "type": "integer"
        },
        "invalid_or_abandoned_cases": {
          "minimum": 0,
          "title": "Invalid Or Abandoned Cases",
          "type": "integer"
        },
        "unresolved_cases": {
          "minimum": 0,
          "title": "Unresolved Cases",
          "type": "integer"
        }
      },
      "required": [
        "automatic_cases",
        "unresolved_cases",
        "human_assisted_cases",
        "invalid_or_abandoned_cases"
      ],
      "title": "AutomationCoverage",
      "type": "object"
    },
    "ConfusionMatrix3": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "accept",
                "check",
                "reject"
              ]
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "accept",
              "check",
              "reject"
            ]
          },
          "title": "Counts",
          "type": "object"
        },
        "labels": {
          "default": [
            "accept",
            "check",
            "reject"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "enum": [
                "accept",
                "check",
                "reject"
              ],
              "type": "string"
            },
            {
              "enum": [
                "accept",
                "check",
                "reject"
              ],
              "type": "string"
            },
            {
              "enum": [
                "accept",
                "check",
                "reject"
              ],
              "type": "string"
            }
          ],
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "counts"
      ],
      "title": "ConfusionMatrix3",
      "type": "object"
    },
    "DecisionCost": {
      "additionalProperties": false,
      "properties": {
        "gpu_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Seconds",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "DecisionCost",
      "type": "object"
    },
    "DecisionReliabilityCardMaterial": {
      "additionalProperties": false,
      "properties": {
        "attempted_calibration_profile_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Attempted Calibration Profile Digests",
          "type": "array"
        },
        "attempted_policy_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Attempted Policy Digests",
          "type": "array"
        },
        "calibration_profile_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Profile Digest"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/DecisionCost"
        },
        "coverage": {
          "$ref": "#/$defs/AutomationCoverage"
        },
        "evaluation_track": {
          "enum": [
            "prequential_campaign_result",
            "frozen_policy_holdout_result",
            "historical_diagnostic_replay_result"
          ],
          "title": "Evaluation Track",
          "type": "string"
        },
        "gate_result": {
          "$ref": "#/$defs/MetricGateResult"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "harness_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Harness Digest",
          "type": "string"
        },
        "label_vault_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Label Vault Digest",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "population_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Population Digest",
          "type": "string"
        },
        "retrieval_index_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Retrieval Index Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.1",
          "default": "0.6.1",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_protocol": {
          "minLength": 1,
          "title": "Selection Protocol",
          "type": "string"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/MetricSlice"
          },
          "title": "Slices",
          "type": "array"
        },
        "statistical_assumptions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Statistical Assumptions",
          "type": "array"
        }
      },
      "required": [
        "card_id",
        "evaluation_track",
        "policy_digest",
        "harness_digest",
        "retrieval_index_digest",
        "label_vault_digest",
        "population_digest",
        "gate_result",
        "coverage",
        "cost",
        "statistical_assumptions",
        "selection_protocol",
        "attempted_policy_digests",
        "generated_at"
      ],
      "title": "DecisionReliabilityCardMaterial",
      "type": "object"
    },
    "IntegerErrorBudget": {
      "additionalProperties": false,
      "properties": {
        "eligible_cases": {
          "minimum": 0,
          "title": "Eligible Cases",
          "type": "integer"
        },
        "maximum_accept_false_positives": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Accept False Positives"
        },
        "oracle_accept_cases": {
          "minimum": 0,
          "title": "Oracle Accept Cases",
          "type": "integer"
        },
        "required_accept_true_positives": {
          "minimum": 0,
          "title": "Required Accept True Positives",
          "type": "integer"
        },
        "required_exact_matches": {
          "minimum": 0,
          "title": "Required Exact Matches",
          "type": "integer"
        }
      },
      "required": [
        "eligible_cases",
        "oracle_accept_cases",
        "required_exact_matches",
        "required_accept_true_positives"
      ],
      "title": "IntegerErrorBudget",
      "type": "object"
    },
    "MetricContract": {
      "additionalProperties": false,
      "properties": {
        "accuracy3_minimum": {
          "maximum": 1,
          "minimum": 0,
          "title": "Accuracy3 Minimum",
          "type": "number"
        },
        "confidence_alpha": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Alpha"
        },
        "confidence_method": {
          "default": "point-estimate",
          "enum": [
            "point-estimate",
            "wilson-one-sided"
          ],
          "title": "Confidence Method",
          "type": "string"
        },
        "contract_id": {
          "title": "Contract Id",
          "type": "string"
        },
        "evaluation_track": {
          "enum": [
            "prequential_campaign_result",
            "frozen_policy_holdout_result",
            "historical_diagnostic_replay_result"
          ],
          "title": "Evaluation Track",
          "type": "string"
        },
        "precision_accept_minimum": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Accept Minimum"
        },
        "recall_accept_minimum": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall Accept Minimum",
          "type": "number"
        },
        "require_nonzero_support": {
          "default": true,
          "title": "Require Nonzero Support",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.6.1",
          "default": "0.6.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "accuracy3_minimum",
        "recall_accept_minimum",
        "evaluation_track"
      ],
      "title": "MetricContract",
      "type": "object"
    },
    "MetricGateResult": {
      "additionalProperties": false,
      "properties": {
        "accuracy_passed": {
          "title": "Accuracy Passed",
          "type": "boolean"
        },
        "accuracy_value_for_gate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy Value For Gate"
        },
        "contract": {
          "$ref": "#/$defs/MetricContract"
        },
        "failure_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Failure Reasons",
          "type": "array"
        },
        "integer_budget": {
          "$ref": "#/$defs/IntegerErrorBudget"
        },
        "metrics": {
          "$ref": "#/$defs/ReliabilityMetrics"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "precision_accept_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precision Accept Passed"
        },
        "precision_accept_value_for_gate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Accept Value For Gate"
        },
        "recall_accept_passed": {
          "title": "Recall Accept Passed",
          "type": "boolean"
        },
        "recall_accept_value_for_gate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall Accept Value For Gate"
        },
        "schema_version": {
          "const": "0.6.1",
          "default": "0.6.1",
          "title": "Schema Version",
          "type": "string"
        },
        "support_passed": {
          "title": "Support Passed",
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "metrics",
        "integer_budget",
        "accuracy_passed",
        "recall_accept_passed",
        "precision_accept_passed",
        "support_passed",
        "passed"
      ],
      "title": "MetricGateResult",
      "type": "object"
    },
    "MetricSlice": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/$defs/ReliabilityMetrics"
        },
        "selector": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Selector",
          "type": "object"
        },
        "slice_id": {
          "title": "Slice Id",
          "type": "string"
        }
      },
      "required": [
        "slice_id",
        "selector",
        "metrics"
      ],
      "title": "MetricSlice",
      "type": "object"
    },
    "ReliabilityMetrics": {
      "additionalProperties": false,
      "properties": {
        "accept_false_negatives": {
          "minimum": 0,
          "title": "Accept False Negatives",
          "type": "integer"
        },
        "accept_false_positives": {
          "minimum": 0,
          "title": "Accept False Positives",
          "type": "integer"
        },
        "accept_true_positives": {
          "minimum": 0,
          "title": "Accept True Positives",
          "type": "integer"
        },
        "accuracy3": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy3"
        },
        "confusion": {
          "$ref": "#/$defs/ConfusionMatrix3"
        },
        "eligible_cases": {
          "minimum": 0,
          "title": "Eligible Cases",
          "type": "integer"
        },
        "exact_matches": {
          "minimum": 0,
          "title": "Exact Matches",
          "type": "integer"
        },
        "invalid_cases": {
          "minimum": 0,
          "title": "Invalid Cases",
          "type": "integer"
        },
        "oracle_accept_cases": {
          "minimum": 0,
          "title": "Oracle Accept Cases",
          "type": "integer"
        },
        "precision_accept": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Accept"
        },
        "predicted_accept_cases": {
          "minimum": 0,
          "title": "Predicted Accept Cases",
          "type": "integer"
        },
        "recall_accept": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall Accept"
        },
        "total_cases": {
          "minimum": 0,
          "title": "Total Cases",
          "type": "integer"
        }
      },
      "required": [
        "total_cases",
        "eligible_cases",
        "invalid_cases",
        "exact_matches",
        "predicted_accept_cases",
        "oracle_accept_cases",
        "accept_true_positives",
        "accept_false_positives",
        "accept_false_negatives",
        "confusion"
      ],
      "title": "ReliabilityMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "card_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Card Sha256",
      "type": "string"
    },
    "material": {
      "$ref": "#/$defs/DecisionReliabilityCardMaterial"
    }
  },
  "required": [
    "material",
    "card_sha256"
  ],
  "title": "DecisionReliabilityCard",
  "type": "object"
}
